<Page
    x:Class="Zink.SplashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#CC00080B">

    <Grid>
        <Image Source="ms-appx:///Assets/ZinkThemeSplash.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <Border Width="88"
                Height="88"
                Margin="0,0,0,88"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                CornerRadius="44"
                BorderBrush="#8A38FF66"
                BorderThickness="1">
            <Border.Background>
                <SolidColorBrush Color="#6600080B"/>
            </Border.Background>

            <ProgressRing x:Name="SplashLoader"
                          IsActive="True"
                          Width="52"
                          Height="52"
                          Foreground="#38FF66"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
