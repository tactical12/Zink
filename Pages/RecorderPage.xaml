<Page
    x:Class="Zink.Pages.RecorderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Zink.Models"
    Background="Transparent">

    <Page.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="#183947"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#24556A"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#102A35"/>
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#26183947"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#7CBFEFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#A8D9FFFF"/>
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5AA4D6FF"/>

        <Style x:Key="RecorderActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#183947"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#7CBFEFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <TextBlock Text="Screen Recorder"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <Border Padding="16"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Status" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" Text="Idle"/>
                    <TextBlock x:Name="TargetText" Text="No capture target selected."/>
                    <TextBlock x:Name="ManualStateText" Text="Manual recording: Stopped"/>
                    <TextBlock x:Name="BackgroundStateText" Text="Background clipping: Stopped"/>
                    <TextBlock Text="Hotkey: Shift + R"/>
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Capture Target" FontSize="20" FontWeight="SemiBold"/>
                    <Button Content="Pick display or window"
                            Style="{StaticResource RecorderActionButtonStyle}"
                            Click="PickTargetButton_Click"/>
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Audio" FontSize="20" FontWeight="SemiBold"/>

                    <ToggleSwitch x:Name="IncludeSystemAudioToggle"
                                  Header="Include system audio"
                                  IsOn="True"/>

                    <ComboBox x:Name="RenderDevicesComboBox"
                              Header="Sound source"
                              DisplayMemberPath="Name"/>

                    <ToggleSwitch x:Name="IncludeMicrophoneToggle"
                                  Header="Include microphone"
                                  IsOn="False"/>

                    <ComboBox x:Name="MicDevicesComboBox"
                              Header="Microphone"
                              DisplayMemberPath="Name"/>
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Manual Recording" FontSize="20" FontWeight="SemiBold"/>
                    <Button Content="Start manual recording"
                            Style="{StaticResource RecorderActionButtonStyle}"
                            Click="StartManualRecordingButton_Click"/>
                    <Button Content="Stop manual recording"
                            Style="{StaticResource RecorderActionButtonStyle}"
                            Click="StopManualRecordingButton_Click"/>
                </StackPanel>
            </Border>

            <Border Padding="16"
                    CornerRadius="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Background Clipping" FontSize="20" FontWeight="SemiBold"/>
                    <Button Content="Start background clipping"
                            Style="{StaticResource RecorderActionButtonStyle}"
                            Click="StartBackgroundButton_Click"/>
                    <Button Content="Stop background clipping"
                            Style="{StaticResource RecorderActionButtonStyle}"
                            Click="StopBackgroundButton_Click"/>
                    <Button Content="Save last 45 seconds now"
                            Style="{StaticResource RecorderActionButtonStyle}"
                            Click="SaveLast45SecondsButton_Click"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Save last 30s"
                                Style="{StaticResource RecorderActionButtonStyle}"
                                Click="SaveLast30SecondsButton_Click"/>
                        <Button Content="Save last 1m"
                                Style="{StaticResource RecorderActionButtonStyle}"
                                Click="SaveLastOneMinuteButton_Click"/>
                        <Button Content="Save last 5m"
                                Style="{StaticResource RecorderActionButtonStyle}"
                                IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock Text="The replay buffer currently keeps up to 45 seconds. Use manual recording for longer clips."
                               Opacity="0.7"
                               TextWrapping="WrapWholeWords"/>
                    <Button Content="Open recordings library"
                            Style="{StaticResource RecorderActionButtonStyle}"
                            Click="OpenRecordingsLibraryButton_Click"/>
                    <ToggleSwitch x:Name="RunAtStartupToggle"
                                  Header="Run at sign-in"
                                  Toggled="RunAtStartupToggle_Toggled"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
