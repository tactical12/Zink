<Page
    x:Class="Zink.Pages.RecordingsLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Recordings Library" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="Saved Zink recordings and replay clips" Opacity="0.75"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="Refresh" Click="RefreshButton_Click"/>
                    <Button Content="Open folder" Click="OpenFolderButton_Click"/>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="StatusBar" IsOpen="False"/>

            <ListView x:Name="RecordingsList"
                      IsItemClickEnabled="True"
                      ItemClick="RecordingsList_ItemClick"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="58" Height="58" CornerRadius="12" Background="#263846">
                                <FontIcon Glyph="&#xE714;"
                                          FontFamily="Segoe Fluent Icons"
                                          FontSize="22"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Details}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Content="Open"
                                    Tag="{Binding Path}"
                                    Click="OpenRecordingButton_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
