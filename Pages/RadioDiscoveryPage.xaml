<Page
    x:Class="Zink.Pages.RadioDiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="Radio Discovery" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Find live radio faster with shortcuts into Zink radio features" Opacity="0.75"/>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Click="OpenRadio_Click" MinHeight="92">
                    <StackPanel Padding="14" Spacing="4">
                        <TextBlock Text="All Stations" FontWeight="SemiBold"/>
                        <TextBlock Text="Browse every built-in Zink station" Opacity="0.7"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Click="OpenLikedSongs_Click" MinHeight="92">
                    <StackPanel Padding="14" Spacing="4">
                        <TextBlock Text="Liked Radio Songs" FontWeight="SemiBold"/>
                        <TextBlock Text="Review songs saved while listening" Opacity="0.7"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Click="OpenWidget_Click" MinHeight="92">
                    <StackPanel Padding="14" Spacing="4">
                        <TextBlock Text="Mini Radio" FontWeight="SemiBold"/>
                        <TextBlock Text="Keep radio available as a floating widget" Opacity="0.7"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" Click="SearchRadio_Click" MinHeight="92">
                    <StackPanel Padding="14" Spacing="4">
                        <TextBlock Text="Search Stations" FontWeight="SemiBold"/>
                        <TextBlock Text="Search across Zink radio and libraries" Opacity="0.7"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
