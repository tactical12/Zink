<Page
    x:Class="Zink.Pages.VisualizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Zink.Pages"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="4">
            <TextBlock Text="Visualizer"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Watch your music come to life with live visuals."
                       Opacity="0.7"
                       FontSize="14"/>
        </StackPanel>

        <!-- Controls -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="16"
                    Margin="0,24,0,16"
                    VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Style"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="StyleComboBox"
                          Width="200"
                          SelectionChanged="StyleComboBox_SelectionChanged">
                    <ComboBoxItem Content="Bars" Tag="Bars" IsSelected="True"/>
                    <ComboBoxItem Content="Mirror bars" Tag="MirrorBars"/>
                    <ComboBoxItem Content="Wave" Tag="Wave"/>
                    <ComboBoxItem Content="Circle" Tag="Circle"/>
                    <ComboBoxItem Content="Dots" Tag="Dots"/>
                    <ComboBoxItem Content="Tunnel" Tag="Tunnel"/>
                    <ComboBoxItem Content="Pulse" Tag="Pulse"/>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Colour"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="ColorComboBox"
                          Width="180"
                          SelectionChanged="ColorComboBox_SelectionChanged">
                    <ComboBoxItem Content="Sky" Tag="Sky" IsSelected="True"/>
                    <ComboBoxItem Content="Fire" Tag="Fire"/>
                    <ComboBoxItem Content="Neon" Tag="Neon"/>
                    <ComboBoxItem Content="Ocean" Tag="Ocean"/>
                    <ComboBoxItem Content="Mono" Tag="Mono"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Width="150">
                <TextBlock x:Name="SensitivityText"
                           Text="Sensitivity 100%"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <Slider x:Name="SensitivitySlider"
                        Minimum="0"
                        Maximum="100"
                        Value="100"
                        ValueChanged="SensitivitySlider_ValueChanged"/>
            </StackPanel>

            <StackPanel Width="150">
                <TextBlock x:Name="SmoothingText"
                           Text="Smoothing 82%"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <Slider x:Name="SmoothingSlider"
                        Minimum="0"
                        Maximum="100"
                        Value="82"
                        ValueChanged="SmoothingSlider_ValueChanged"/>
            </StackPanel>

            <ToggleButton x:Name="PauseToggle"
                          Content="Pause animation"
                          Checked="PauseToggle_Checked"
                          Unchecked="PauseToggle_Unchecked"
                          VerticalAlignment="Bottom"/>

            <Button x:Name="SaveButton"
                    Content="Save"
                    Click="SaveButton_Click"
                    VerticalAlignment="Bottom"/>

            <Button x:Name="ResetButton"
                    Content="Reset"
                    Click="ResetButton_Click"
                    VerticalAlignment="Bottom"/>
        </StackPanel>

        <!-- Visualizer canvas -->
        <Border Grid.Row="2"
                CornerRadius="16"
                Padding="0"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Canvas x:Name="VisualizerCanvas"/>

                <TextBlock x:Name="HintText"
                           Text="Play audio in Zink or on this PC to drive the visualizer."
                           Opacity="0.5"
                           FontSize="12"
                           Margin="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           TextWrapping="WrapWholeWords"/>
            </Grid>
        </Border>
    </Grid>
</Page>
